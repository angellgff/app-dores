{
  "expo": {
    "name": "Dores",
    "slug": "coracampos",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/logo-mobile.png",
      "bundler": "metro",
      "output": "static",
      "name": "Dores",
      "shortName": "Dores",
      "description": "Encuentra los mejores restaurantes y servicios de delivery cerca de ti",
      "themeColor": "#000000",
      "backgroundColor": "#fcfdfd",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/",
      "icon": "./assets/logo-mobile.png",
      "splash": {
        "image": "./assets/splash.png",
        "backgroundColor": "#fcfdfd"
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fcfdfd",
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir a $(PRODUCT_NAME) usar tu ubicación."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-mobile.png",
          "color": "#ffffff"
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/logo-mobile.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dore.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-mobile.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dores.app"
    },
    "notification": {
      "icon": "./assets/logo-mobile.png",
      "color": "#ffffff",
      "iosDisplayInForeground": true,
      "androidMode": "default"
    },
    "newArchEnabled": true,
    "owner": "vmoreira1987",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "1120d18c-4e8b-4b21-b11f-6d75c8125388"
      }
    }
  }
}
